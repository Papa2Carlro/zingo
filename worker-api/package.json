{
  "name": "zingo-worker-api",
  "version": "1.0.0",
  "description": "ZINGO API on Cloudflare Workers with D1",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:create": "wrangler d1 create zingo-db",
    "db:migrate": "wrangler d1 migrations apply zingo-db --local",
    "db:migrate:prod": "wrangler d1 migrations apply zingo-db --remote",
    "db:seed": "wrangler d1 execute zingo-db --local --file=./seed.sql",
    "db:seed:prod": "wrangler d1 execute zingo-db --remote --file=./seed.sql"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.9.0",
    "hono": "^4.0.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.2024000.0",
    "typescript": "^5.3.0",
    "wrangler": "^3.0.0"
  }
}
