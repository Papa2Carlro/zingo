# Server
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
ENV=development

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=zingo
DB_PASSWORD=zingo
DB_NAME=zingo
DB_SSLMODE=disable

# Redis (for rate limiting, sessions)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT
JWT_SECRET=change-me-in-production-use-long-random-string
JWT_EXPIRY_HOURS=24

# Admin
ADMIN_TOKEN=change-me-admin-token

# Rate Limiting
RATE_LIMIT_ANON=100
RATE_LIMIT_AUTH=1000
RATE_LIMIT_WINDOW_MINUTES=1

# CORS
CORS_ALLOWED_ORIGINS=*

# Logging
LOG_LEVEL=debug
LOG_FORMAT=json